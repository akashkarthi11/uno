{
  "regions": ["bom1"],
  "functions": {
    "api/game.js": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "growx-cards.vercel.app" }],
      "destination": "https://growx-mindrelax.vercel.app/$1",
      "permanent": false
    }
  ]
}
